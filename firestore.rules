rules_version = '2';

// Arsenal Atlas security rules.
//
// Content is world-readable (it's an encyclopedia) but writable only by an
// admin custom claim. The claim lives on the token, never in a document, so
// a compromised client cannot escalate by editing its own user record.
//
// The admin dashboard UI is deferred, but these rules ship now so the write
// path is never open in the interim.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Reject unbounded strings so a bad write can't bloat a document.
    function boundedString(field, maxLen) {
      return !(field in request.resource.data) ||
             (request.resource.data[field] is string &&
              request.resource.data[field].size() <= maxLen);
    }

    function validEquipment() {
      let d = request.resource.data;
      return d.keys().hasAll(['slug', 'name', 'kind', 'category', 'description', 'sources'])
             && d.slug is string && d.slug.size() > 0 && d.slug.size() <= 120
             && d.slug.matches('^[a-z0-9-]+$')
             && d.name is string && d.name.size() > 0 && d.name.size() <= 200
             && d.kind is string
             && d.category is string
             // Attribution is mandatory: CC BY-SA content cannot ship without it.
             && d.sources is list && d.sources.size() > 0
             && boundedString('description', 4000)
             && boundedString('history', 40000)
             && boundedString('development', 40000);
    }

    // ── Public content ────────────────────────────────────────
    match /equipment/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validEquipment();
      allow delete: if isAdmin();
    }

    match /searchIndex/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{col}/{id} {
      allow read: if col in ['categories', 'countries', 'manufacturers', 'conflicts', 'families'];
      allow write: if isAdmin()
                   && col in ['categories', 'countries', 'manufacturers', 'conflicts', 'families'];
    }

    // ── Per-user private data ─────────────────────────────────
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{sub}/{docId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
                     && sub in ['favorites', 'recentlyViewed', 'collections']
                     // Cap subcollection document size.
                     && request.resource.data.keys().size() <= 20;
      }
    }

    // Deny anything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
