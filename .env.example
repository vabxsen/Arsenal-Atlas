# ── Arsenal Atlas environment ────────────────────────────────
# Copy to `.env.local` and fill in when you have a Firebase project.
#
# You do NOT need real credentials to develop. Leave these blank and set
# VITE_USE_EMULATORS=true to run entirely against the Local Emulator Suite:
#
#   npm run emulators      # terminal 1
#   npm run seed           # terminal 2, once
#   npm run dev            # terminal 3

VITE_USE_EMULATORS=true

VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=arsenal-atlas-local
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=

# Public origin, used for canonical URLs, sitemap, and Open Graph tags.
VITE_SITE_URL=https://arsenalatlas.firebaseapp.com

# ── Seed pipeline (Node-side, not exposed to the browser) ────
# Wikimedia asks that API clients identify themselves with a contact.
# https://foundation.wikimedia.org/wiki/Policy:User-Agent_policy
SEED_USER_AGENT=ArsenalAtlas/0.1 (https://arsenalatlas.firebaseapp.com; contact@example.com)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
GOOGLE_CLOUD_PROJECT=arsenal-atlas-local
