{
  "name": "arsenal-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A premium encyclopedia of the world's military equipment.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/prerender.ts",
    "prerender": "tsx scripts/prerender.ts",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "seed": "tsx scripts/seed/index.ts",
    "push": "tsx scripts/seed/push.ts",
    "a11y": "tsx scripts/a11y.ts",
    "verify:images": "tsx scripts/verifyOgImages.ts",
    "emulators": "firebase emulators:start --import=./.emulator-data --export-on-exit=./.emulator-data"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "dompurify": "^3.4.12",
    "firebase": "^12.17.0",
    "framer-motion": "^12.43.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome-remote-interface": "^0.34.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.12.1",
    "chrome-launcher": "^1.2.1",
    "chrome-remote-interface": "^0.34.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "firebase-admin": "^14.2.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20"
  }
}
